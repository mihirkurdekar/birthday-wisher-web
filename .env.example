# Copy to .env and fill in. Never commit .env.
# Values marked REQUIRED must be set for the feature to work.

# --- Birthday config (REQUIRED) ---
FRIEND_NAME=Aria
BIRTH_DATE=2025-11-27
# Tone: any custom sentence OR one of the built-in keywords (warm, funny, poetic)
# Examples: "warm" | "funny and a bit teasing" | "poetic like a love letter" | "like your cool older sibling"
TONE=warm

# Memories: JSON array of 3-5 short lines. The AI will use ONLY these.
# Escape quotes for the .env file (use single quotes around the whole value or double-escape).
MEMORIES=["The time we got lost in Kyoto and found that tiny mochi shop", "Your laugh when the cat stole your sandwich", "How you remember everyone's coffee order"]

# --- AI config (REQUIRED for AI wishes; fallbacks used if missing/fails) ---
AI_API_KEY=tesst_API
# Model name(s) — comma-separated for round-robin fallback (Gemini models shown; adapt for your provider)
AI_MODEL=gemini-2.5-flash
# Optional: prioritized model list (takes precedence over AI_MODEL if set)
# AI_MODEL_PRIORITIES=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro

# --- Deployment / Lambda config ---
# SELF_ORIGIN: the public Function URL (e.g. https://abc.lambda-url.us-east-1.on.aws)
# Leave empty for local dev; set in prod for CORS + origin check.
SELF_ORIGIN=

# Reserved concurrency limit (cost control — anyone with the URL can call /wish)
# Set in Terraform, not here. Typical: 5–10.
# RESERVED_CONCURRENCY=5

# --- Local testing ONLY ---
# OVERRIDE_NOW: epoch ms or ISO string to simulate a different current time.
# Example: OVERRIDE_NOW=2025-11-27T00:00:10+05:30
# NEVER set this in production — it would bypass the birthday lock.
OVERRIDE_NOW=

# FORCE_FALLBACKS=1 to test fallback wishes while AI is configured.
FORCE_FALLBACKS=0